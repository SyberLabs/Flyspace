# ============================================
# OMNI_OS — Environment Configuration
# ============================================
# Copy this file to `.env` and fill in the keys you need.
# `.env*` is gitignored — never commit real keys.
#
# This is a LOCAL-FIRST, SINGLE-USER app. All keys below are read
# server-side (process.env) and are never sent to or stored in the browser.
# Public hosting would expose these keys to every visitor and must add
# authentication first. See IMPLEMENTATION_PLAN.md.

# --- LLM providers (Mind / personas) ---
# Local (Ollama) needs no key. Set the URL only if Ollama runs elsewhere.
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Jev persona suggestion. Disabled unless OMNI_JEV_ENABLED=1. Before enabling
# on a public host, give this key a spend cap and rate-limit /api/jev-persona
# at Cloudflare. The browser sends only the question the user explicitly enters.
OPENROUTER_API_KEY=
OMNI_JEV_ENABLED=
NEXT_PUBLIC_OMNI_JEV_ENABLED=

# Public preview: disables paid text generation, keyed data, and shared ledger
# reads at their server routes. Set both values to 1 for matching server/UI.
OMNI_PUBLIC_DEMO=
NEXT_PUBLIC_OMNI_PUBLIC_DEMO=

# --- Data APIs ---
# Read server-side and proxied through /api/data. These never reach the
# browser: the block asks OmniOS, and OmniOS asks the provider.

# NewsAPI - https://newsapi.org/
NEWSAPI_KEY=

# FRED (Federal Reserve economic series) - https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Bureau of Labor Statistics - https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Alpha Vantage (equities) - https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Metaculus (forecasts) - https://www.metaculus.com/accounts/signup/
METACULUS_API_KEY=

# Polymarket uses a public API and needs no key.

# --- Inference ledger (OPTIONAL) ---
# Durable server-side record of LLM executions. Postgres owns ONLY this;
# canvas state stays in IndexedDB. Leave DATABASE_URL blank and the ledger
# is a no-op — the app runs exactly as it did without it.
#
# Read server-side only. Create the schema with `npm run db:migrate`.
# See INFERENCE_LEDGER.md.
DATABASE_URL=

# A SEPARATE, throwaway database for the ledger integration tests, which
# TRUNCATE tables. Never point this at the database above.
#   OMNI_TEST_DATABASE_URL=postgres://localhost:5432/omni_test
OMNI_TEST_DATABASE_URL=

# --- Debugging ---
# Set to 1 to enable verbose gateway/block diagnostic logging in the console.
NEXT_PUBLIC_OMNI_DEBUG=
