# ============================================
# OMNI_OS — Environment Configuration
# ============================================
# Copy this file to `.env` and fill in the keys you need.
# `.env*` is gitignored — never commit real keys.
#
# This is a LOCAL-FIRST, SINGLE-USER app. All keys below are read
# server-side (process.env) and are never sent to or stored in the browser.
# Public hosting would expose these keys to every visitor and must add
# authentication first. See DEPLOYMENT.md.

# --- LLM providers (Mind / personas) ---
# Local (Ollama) needs no key. Set its URL on the server if it runs elsewhere;
# requests from the browser cannot select a server-side destination.
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Persona suggestion. Kev is the default provider; set DECISION_PROVIDER=jev
# and NEXT_PUBLIC_DECISION_PROVIDER=jev for explicit Jev rollback. Disabled
# unless the selected provider's feature flag is 1. The browser sends only
# the submitted question.
DECISION_PROVIDER=kev
NEXT_PUBLIC_DECISION_PROVIDER=kev
KEV_BASE_URL=
KEV_API_KEY=
KEV_MODEL=kev-latest
# Immutable 40-character deployment/model commit SHA. The Kev endpoint must
# attest this value in its X-Kev-Revision response header on every request.
KEV_REVISION=
# Set only after approving transmission to this specific Kev host.
OMNI_KEV_ENABLED=
# Jev rollback key. Cap spend and rate-limit /api/jev-persona before public use.
OPENROUTER_API_KEY=
OMNI_JEV_ENABLED=
NEXT_PUBLIC_OMNI_KEV_ENABLED=
NEXT_PUBLIC_OMNI_JEV_ENABLED=

# Public preview: disables paid text generation and shared ledger reads at
# their server routes. Set both values to 1 for matching server/UI.
OMNI_PUBLIC_DEMO=
NEXT_PUBLIC_OMNI_PUBLIC_DEMO=

# --- API registry search: JEV intent routing (OPTIONAL) ---
# "Search APIs" in the install door works without this: keyword search over
# the bundled API index. With it, the server asks TypeSafe's JEV which kind of
# API a search is about, so "is it going to rain tomorrow" finds a weather API.
# Setting OMNI_REGISTRY_JEV_ENABLED=1 is the decision to send search text (and
# only search text) to api.typesafe.ai. Always off when OMNI_PUBLIC_DEMO=1.
# Key: https://console.typesafe.ai (API Keys). Server-side only.
OMNI_REGISTRY_JEV_ENABLED=
TYPESAFE_API_KEY=

# --- Inference ledger (OPTIONAL) ---
# Durable server-side record of LLM executions. Postgres owns ONLY this;
# canvas state stays in IndexedDB. Leave DATABASE_URL blank and the ledger
# is a no-op — the app runs exactly as it did without it.
#
# Read server-side only. Create the schema with `npm run db:migrate`.
# See INFERENCE_LEDGER.md.
DATABASE_URL=

# --- Hosted API identity ---
# Development is local-only unless OMNI_DEPLOYMENT_MODE=hosted. Production
# defaults to hosted and fails closed without this OIDC configuration.
# OMNI_DEPLOYMENT_MODE=local is an explicit trusted opt-in for loopback/private
# single-user use only; never set it on a publicly reachable deployment.
# OMNI_DEPLOYMENT_MODE=local
OMNI_AUTH_ISSUER=
# API/resource audience expected in access-token aud; not the browser client ID
# and not an ID-token audience.
OMNI_AUTH_AUDIENCE=

# --- Ingress ---
# Per-caller rate budgets (today: /api/capability-broker) key on the client
# address, read from a header only when you declare what owns that header:
#   cloudflare  a Cloudflare Worker or proxied zone; cf-connecting-ip is used
#   proxy       a reverse proxy you control; x-real-ip, else the last
#               x-forwarded-for hop ("1" is the older spelling of proxy)
# Unset, no header is trusted: a bare `next dev`, `next start` or
# `wrangler dev` has no ingress that owns them, so every caller shares one
# bucket under the global cap and a forged header buys nothing.
# OMNI_TRUSTED_PROXY=cloudflare

# A SEPARATE, throwaway database for the ledger integration tests, which
# TRUNCATE tables. Never point this at the database above.
#   OMNI_TEST_DATABASE_URL=postgres://localhost:5432/omni_test
OMNI_TEST_DATABASE_URL=

# --- Debugging ---
# Set to 1 to enable verbose gateway/block diagnostic logging in the console.
NEXT_PUBLIC_OMNI_DEBUG=
