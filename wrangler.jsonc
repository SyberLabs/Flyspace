{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omni-os",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "omni.syberlabs.io", "custom_domain": true }
  ],
  "vars": {
    "OMNI_PUBLIC_DEMO": "1",
    "NEXT_PUBLIC_OMNI_PUBLIC_DEMO": "1"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
